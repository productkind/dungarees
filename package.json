{
  "name": "dungarees",
  "private": true,
  "description": "Workspace root of the dungarees libraries when built on their own, as in the productkind/dungarees mirror",
  "type": "module",
  "scripts": {
    "publish:libs": "dungarees publish-multi-lib .",
    "test": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/productkind/dungarees.git"
  },
  "license": "MIT",
  "dependencies": {
    "@dungarees/bin-runtime-cli-yargs": "*"
  },
  "workspaces": [
    "src/*",
    "src/bin/**/",
    "src/todo-mvc/**/",
    "e2e/"
  ],
  "devDependencies": {
    "happy-dom": "^20.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
